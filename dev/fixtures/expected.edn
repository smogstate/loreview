                 {:biz/client-name "Globex"   :biz/invoice-id "i05" :biz/due-date "2026-11-30" :biz/days-overdue -6  :biz/amount nil}]
          :notes {:hidden #{:biz/amount} :rows-filtered #{:biz/client}}}}}]
